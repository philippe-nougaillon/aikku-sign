<div id="<%= dom_id presence %>" class="flex flex-col shadow p-4 hover:shadow-xl ease-out duration-500 gap-2 mt-4">
  <div>
    <small class="italic text-secondary">
      <i>Il y a <%= time_ago_in_words presence.heure %></i>
    </small>

    <p class="text-2xl text-primary">
      <%= link_to presence.user.nom, presences_path(user_id: presence.user.id) %>
    </p>

    <p class="text-xl">
      <%= link_to presence.assemblee.nom.humanize, presences_path(assemblee_id: presence.assemblee.id) %>
    </p>

    <p class="text-secondary">
      <%= presence.assemblee.horaires_medium %>
    </p>
  </div>
  
  <img src=<%= presence.signature %> style="padding: 10px; height:125px">
  
  <%= button_to presence, method: :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer cet émargement ?" }, class:'text-base-300 hover:text-error float-end' do %>
    <span class="material-symbols-outlined">
      delete
    </span>
  <% end %>
</div>
