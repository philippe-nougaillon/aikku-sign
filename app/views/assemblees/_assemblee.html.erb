<div id="<%= dom_id assemblee %>" class="mt-4 pb-4 border-b border-gray-200">
  <div class="flex flex-wrap gap-8">
    <div>
      <p class="text-3xl font-bold text-primary hover:underline">
        <% if assemblee.repeter? %>
          <span class="material-symbols-outlined">
              event_repeat
            </span>
        <% end %>
        <%= assemblee.nom.humanize %>
      </p>
      
      <p class="font-bold">
        <%= assemblee.horaires_long.humanize %>
        <% if assemblee.début > DateTime.now %>
          <span class="text-success italic">
            (débute dans <%= time_ago_in_words assemblee.début %>)
          </span>
        <% elsif assemblee.in_progress? %>
          <span class="text-error italic">
            (fin de session dans <%= time_ago_in_words assemblee.fin %>)
          </span>
        <% end %>
      </p>


      <% if assemblee.repeter? %>
        <div class="flex mt-4">
          <div class="flex-initial w-20">
            Répéter :  
          </div>
          <div class="flex-grow w-28">
            <%= 'L' if assemblee.repeter_lun? %>
            <%= 'Ma' if assemblee.repeter_mar? %>
            <%= 'Me' if assemblee.repeter_mer? %>
            <%= 'J' if assemblee.repeter_jeu? %>
            <%= 'V' if assemblee.repeter_ven? %>
            <%= 'S' if assemblee.repeter_sam? %>
            <%= 'D' if assemblee.repeter_dim? %>
          </div>
          <div>
            <% if assemblee.fin_repeter %>
              Jusqu'au 
              <%= l assemblee.fin_repeter %>
              (encore <%= (assemblee.fin_repeter.to_date - Date.today).to_i %> fois)
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="flex mt-4">
        <div class="flex-initial w-20">
            Groupes : 
        </div>
        <div class="flex-grow w-28">
            <% assemblee.tags.each do |tag| %>
              <span class="badge badge-lg font-bold shadow"><%= link_to tag.name.humanize, users_path(tags: [tag.name]), class: "hover:underline" %></span>
            <% end %>
        </div>
        <div>
          Gestionnaire : 
          <%= assemblee.user.nom_prénom %> (<%= assemblee.user.email %>)
        </div>
      </div>

      <div class="flex my-4">
        <div class="flex-initial w-20">
          Statut : 
        </div>
        <div class="flex-grow w-28">
          <span class="text-nowrap font-bold shadow <%= assemblee.style %>">
            <%= assemblee.workflow_state.humanize %>
          </span>
        </div>
        <div>
          <%= link_to "#{assemblee.presences.count} émargement(s)", presences_path(assemblee_id: assemblee.id), class: 'text-primary hover:underline' %>
          /
          <%= link_to "#{assemblee.related_users.count} participant(s)", users_path(assemblee_id: assemblee.id), class: 'text-primary hover:underline' %>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 mt-6">
        <%= link_to "Dupliquer", new_assemblee_path(assemblee_id: assemblee), class:'btn btn-success btn-outline hover:!text-white btn-sm' %>
        <%= link_to "Générer Convocations", assemblee_path(assemblee, format: :pdf), class:'btn btn-secondary btn-outline hover:!text-white btn-sm', target: "_blank", title: "Générer les convocations (PDF)" %>
        <%= link_to "Modifier", edit_assemblee_path(assemblee), class:'btn btn-primary btn-outline hover:!text-white btn-sm' %>
        <% if assemblee.fin > DateTime.now %>
          <%= link_to "Envoyer le lien au gestionnaire", envoyer_lien_gestionnaire_assemblee_path(assemblee), class: 'btn btn-warning btn-outline hover:!text-white btn-sm', title: "Envoyer au gestionnaire un mail contenant le lien public vers la feuille d'émargement des présences" %>
        <% end %>
        <%= button_to assemblee, method: :delete, data: {turbo_confirm: "Êtes-vous certain(e) de vouloir supprimer cette session ? Attention, cela supprimera aussi toutes les signatures liées à cette session !!!" }, class: 'btn btn-error btn-outline hover:!text-white btn-sm' do %>
          <span class="material-symbols-outlined">
            delete
          </span>
        <% end %>
      </div>
    </div>

    <% if assemblee.in_progress? %>
      <div class="self-end shadow p-4">
        <%= raw assemblee.qrcode(admin_signature_collective_url(assemblee_id: assemblee.slug)) %>
        <%= link_to "Signer maintenant !", admin_signature_collective_url(assemblee_id: assemblee.slug), class: 'btn btn-outline text-success mt-4 w-full', target: '_blank', title: "Lancer la session de signature collective ou flasher le Qr-code pour émarger à partir d'un autre appareil (Tablette)" %>
      </div>
    <% end %>

  </div>
</div>
