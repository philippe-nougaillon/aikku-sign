<%= form_with(model: assemblee) do |form| %>
  <% if assemblee.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(assemblee.errors.count, "error") %> prohibited this assemblee from being saved:</h2>

      <ul>
        <% assemblee.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
      
    </div>
  <% end %>

  <div>
    <%= form.label :nom, style: "display: block" %>
    <%= form.text_field :nom, class: 'input input-bordered input-sm w-full', required: true, placeholder: 'ex: Commission Mobilité' %>
  </div>

  <div class="mt-4">
    <%= form.label :tags, "Groupes d'intérêt", style: "display: block" %>
    <%= form.select :tags, options_from_collection_for_select(@tags, :name, :name, assemblee.tags.map(&:name)), multiple: true %>
    <div class="label">
      <span class="label-text-alt">
        Pour associer des participants à cette session, 
        par groupes d'intérêt. Pour ajouter un nouveau groupe; entrez son nom 
        et cliquez sur [+]
      </span>
    </div>
  </div>

  <div class="flex gap-4">
    <div class="flex-1 mt-4">
      <%= form.label :début, style: "display: block" %>
      <%= form.datetime_field :début, class: 'input input-bordered input-sm w-full', required: true %>
    </div>

    <div class="flex-1 mt-4">
      <%= form.label :durée, "Durée (h)", style: "display: block" %>
      <%= form.number_field :durée, step: :any, class: 'input input-bordered input-sm w-full' %>
    </div>
  </div >

  <div class="flex gap-4">
    <div class="flex-1 mt-8" title="Répéter cette session ?">
      <%= form.check_box :repeter %>
      <%= form.label :repeter, "Répéter cette session ?" %>
    </div>

    <div class="flex-1 mt-4">
      <%= form.label :fin_repeter, "Jusqu'au", style: "display: block" %>
      <%= form.datetime_field :fin_repeter, class: 'input input-bordered input-sm w-full', required: true %>
    </div>
  </div>

  <div class="flex">
    <div class="p-2">
      <%= form.check_box :repeter_lun %>
      <%= form.label :repeter_lun, "Lundi" %>
    </div>
    <div class="p-2">
      <%= form.check_box :repeter_mar %>
      <%= form.label :repeter_mar, "Mardi" %>
    </div>
    <div class="p-2">
      <%= form.check_box :repeter_mer %>
      <%= form.label :repeter_mer, "Mer." %>
    </div>
    <div class="p-2">
      <%= form.check_box :repeter_jeu %>
      <%= form.label :repeter_jeu, "Jeudi" %>
    </div>
    <div class="p-2">
      <%= form.check_box :repeter_ven %>
      <%= form.label :repeter_ven, "Ven." %>
    </div>
    <div class="p-2">
      <%= form.check_box :repeter_sam %>
      <%= form.label :repeter_sam, "Samedi" %>
    </div>
    <div class="p-2">
      <%= form.check_box :repeter_dim %>
      <%= form.label :repeter_dim, "Dim." %>
    </div>
  </div>

  <div class="mt-4">
    <%= form.label "Lieu (adresse)", style: "display: block" %>
    <%= form.text_area :adresse, class: 'textarea textarea-bordered textarea-xs w-full' %>
  </div>

  <div class="mt-4" title="Envoyer automatiquement le lien pour une session collective de signatures (généralement via un partage de tablette) 10 minutes avant le début de la session">
    <%= form.check_box :automatique %>
    <%= form.label :automatique, "Envoyer le lien collectif à l'admin de la session ? " %>
  </div>

  <div class="mt-4" title="Envoyer automatiquement le lien individuel à tous les participants 10 minutes avant le début de la session ?">
    <%= form.check_box :notifier_participants %>
    <%= form.label :notifier_participants, "Envoyer le lien individuel aux participants ?" %>
  </div>

  <% if assemblee.persisted? %>
    <div class="mt-4">
      <%= form.label :workflow_state, "Statut", style: "display: block" %>
      <%= form.select :workflow_state, options_for_select(Assemblee.workflow_spec.states.keys, assemblee.workflow_state), {}, class: 'input input-bordered input-sm w-full', required: true  %>
    </div>
  <% end %>

  <div>
    <%= form.submit "Enregistrer", class:'btn btn-primary btn-outline hover:!text-white w-full mt-8 mb-4' %>
    <%= link_to "Retour", assemblees_path, class:'link' %>
  </div>
<% end %>

<script>
  // slimselect
  new SlimSelect({
    select: '#assemblee_tags',
    settings: {
      searchPlaceholder: 'Recherche',
      searchText: 'Pas de résultat',
      searchingText: 'Recherche...',
      placeholderText: 'Choisissez un ou plusieurs groupes',
      allowDeselect: true,
    },
    events: {
      addable: function (value) {
        return value
      }
    }
  })
</script>