<div class="timeline-<%= start ? 'start' : 'end' %> timeline-box">
  <%= link_to assemblee_path(assemblee) do %>
    <span class="font-bold text-xl text-primary">
      <%= assemblee.nom.humanize %>
    </span>

    <p>
      <% if assemblee.repeter? %>
        <span class="material-symbols-outlined" style="font-size: 16px;">
          event_repeat
        </span>
      <% end %>
      <%= assemblee.horaires_medium.humanize %>
    </p>

    <p class="mt-4">
      <% assemblee.tags.each do |tag| %>
        <span class="font-bold <%= assemblee.style %>"><%= assemblee.workflow_state.humanize %></span>
      <% end %>
    </p>

    <p class="italic text-xs mt-2">
      <% if assemblee.début > DateTime.now %>
        <span class="text-success">
          (débute dans <%= time_ago_in_words assemblee.début %>)
        </span>
      <% elsif ((assemblee.début + assemblee.durée.to_f.hours) - Time.current).positive? %>
        <span class="text-error">
          fin de session dans 
          <time 
            data-controller="timeago" 
            data-timeago-datetime-value="<%= assemblee.fin %>" 
            data-timeago-refresh-interval-value="60000">
          </time>.
        </span>
      <% end %>
    </p>

  <% end %>
</div>